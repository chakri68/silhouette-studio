{
  "name": "silhouette_studio",
  "short_name": "silhouette",
  "description": "Extract a clean cutout or silhouette from any image, right in your browser. Auto-segment, brush-refine, export PNG / SVG / traced silhouette.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
